  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <Compile Include="..\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\Storage.cs" Link="Shared\Storage.cs" />
  </ItemGroup>
</Project>
